{
  "version": "1.0",
  "policy": {
    "secret_values_in_repo": false,
    "frontend_secret_access": false,
    "log_secret_values": false,
    "source": "authorized secret store imported from user-provided Drive env",
    "rotation_supported": true
  },
  "providers": {
    "groq": {
      "required": false,
      "slots": [
        "GROQ_API_KEY",
        "GROQ_API_KEY_01",
        "GROQ_API_KEY_02",
        "GROQ_API_KEY_03",
        "GROQ_API_KEY_04",
        "GROQ_API_KEY_05",
        "GROQ_API_KEY_06",
        "GROQ_API_KEY_07",
        "GROQ_API_KEY_08",
        "GROQ_API_KEY_09",
        "GROQ_API_KEY_10"
      ],
      "model_env": "GROQ_MODEL"
    },
    "openai": {
      "required": false,
      "slots": ["OPENAI_API_KEY"],
      "model_env": "OPENAI_MODEL"
    },
    "anthropic": {
      "required": false,
      "slots": ["ANTHROPIC_API_KEY"],
      "model_env": "ANTHROPIC_MODEL"
    },
    "gemini": {
      "required": false,
      "slots": ["GEMINI_API_KEY"],
      "model_env": "GEMINI_MODEL"
    },
    "cerebras": {
      "required": false,
      "slots": ["CEREBRAS_API_KEY"],
      "model_env": "CEREBRAS_MODEL"
    }
  },
  "runtime": {
    "AI_ENABLED": "true",
    "AI_TIMEOUT_SECONDS": "8",
    "strategy": "priority_then_health_failover",
    "deterministic_fallback": true
  }
}
