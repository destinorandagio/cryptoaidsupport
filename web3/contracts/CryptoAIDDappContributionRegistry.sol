pragma solidity ^0.8.24;
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
contract CryptoAIDDappContributionRegistry is AccessControl{bytes32 public constant REVIEWER_ROLE=keccak256("REVIEWER_ROLE");enum Status{NONE,SUBMITTED,ACCEPTED,REJECTED}struct Contribution{address author;bytes32 entityId;bytes32 evidenceHash;uint64 submittedAt;Status status;}mapping(bytes32=>Contribution)public contributions;event Submitted(bytes32 indexed id,address indexed author,bytes32 indexed entityId,bytes32 evidenceHash);event Reviewed(bytes32 indexed id,Status status);constructor(address admin){_grantRole(DEFAULT_ADMIN_ROLE,admin);_grantRole(REVIEWER_ROLE,admin);}function submit(bytes32 id,bytes32 entityId,bytes32 evidenceHash)external{require(id!=0&&entityId!=0&&evidenceHash!=0&&contributions[id].status==Status.NONE,"BAD");contributions[id]=Contribution(msg.sender,entityId,evidenceHash,uint64(block.timestamp),Status.SUBMITTED);emit Submitted(id,msg.sender,entityId,evidenceHash);}function review(bytes32 id,bool accept)external onlyRole(REVIEWER_ROLE){Contribution storage c=contributions[id];require(c.status==Status.SUBMITTED,"STATE");c.status=accept?Status.ACCEPTED:Status.REJECTED;emit Reviewed(id,c.status);} }
