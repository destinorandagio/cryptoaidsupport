pragma solidity ^0.8.24;
import {ERC1155} from "@openzeppelin/contracts/token/ERC1155/ERC1155.sol";
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
contract CryptoAIDAchievements is ERC1155,AccessControl{bytes32 public constant MINTER_ROLE=keccak256("MINTER_ROLE");mapping(uint256=>bool)public uniquePerWallet;constructor(address admin,string memory uri_)ERC1155(uri_){_grantRole(DEFAULT_ADMIN_ROLE,admin);_grantRole(MINTER_ROLE,admin);}function setUnique(uint256 id,bool v)external onlyRole(DEFAULT_ADMIN_ROLE){uniquePerWallet[id]=v;}function award(address to,uint256 id,uint256 amount)external onlyRole(MINTER_ROLE){require(to!=address(0)&&amount>0,"BAD");if(uniquePerWallet[id])require(balanceOf(to,id)==0&&amount==1,"UNIQUE");_mint(to,id,amount,"");}function safeTransferFrom(address,address,uint256,uint256,bytes memory)public pure override{revert("SOULBOUND");}function safeBatchTransferFrom(address,address,uint256[] memory,uint256[] memory,bytes memory)public pure override{revert("SOULBOUND");}function supportsInterface(bytes4 i)public view override(ERC1155,AccessControl)returns(bool){return super.supportsInterface(i);} }
