pragma solidity ^0.8.24;
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
contract CryptoAIDSecurityController is AccessControl{bytes32 public constant POLICY_ROLE=keccak256("POLICY_ROLE");mapping(address=>bool)public allowedModule;mapping(bytes4=>bool)public blockedSelector;uint256 public maxRewardBoostBps=15000;event ModuleSet(address indexed module,bool allowed);event SelectorSet(bytes4 indexed selector,bool blocked);constructor(address admin){_grantRole(DEFAULT_ADMIN_ROLE,admin);_grantRole(POLICY_ROLE,admin);}function setModule(address m,bool a)external onlyRole(POLICY_ROLE){require(m!=address(0),"ZERO");allowedModule[m]=a;emit ModuleSet(m,a);}function setBlockedSelector(bytes4 s,bool b)external onlyRole(POLICY_ROLE){blockedSelector[s]=b;emit SelectorSet(s,b);}function setMaxRewardBoostBps(uint256 bps)external onlyRole(DEFAULT_ADMIN_ROLE){require(bps>=10000&&bps<=20000,"RANGE");maxRewardBoostBps=bps;}function validate(address module,bytes4 selector,uint256 boostBps)external view returns(bool){return allowedModule[module]&&!blockedSelector[selector]&&boostBps<=maxRewardBoostBps;}}
