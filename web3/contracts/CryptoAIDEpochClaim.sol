pragma solidity ^0.8.24;
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {MerkleProof} from "@openzeppelin/contracts/utils/cryptography/MerkleProof.sol";
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
contract CryptoAIDEpochClaim is AccessControl,ReentrancyGuard {using SafeERC20 for IERC20;struct Epoch{bytes32 root;IERC20 token;uint64 deadline;bool enabled;}mapping(uint256=>Epoch) public epochs;mapping(uint256=>mapping(uint256=>uint256)) private claimed;event EpochSet(uint256 indexed epoch,bytes32 root,address token,uint64 deadline);event Claimed(uint256 indexed epoch,uint256 indexed index,address indexed account,uint256 amount);constructor(address admin){_grantRole(DEFAULT_ADMIN_ROLE,admin);}function setEpoch(uint256 e,bytes32 root,IERC20 token,uint64 deadline)external onlyRole(DEFAULT_ADMIN_ROLE){require(root!=0&&address(token)!=address(0)&&deadline>block.timestamp,"BAD");epochs[e]=Epoch(root,token,deadline,true);emit EpochSet(e,root,address(token),deadline);}function isClaimed(uint256 e,uint256 i)public view returns(bool){uint256 w=i>>8;uint256 b=i&255;return claimed[e][w]&(1<<b)!=0;}function claim(uint256 e,uint256 i,address account,uint256 amount,bytes32[] calldata proof)external nonReentrant{Epoch memory x=epochs[e];require(x.enabled&&block.timestamp<=x.deadline&&!isClaimed(e,i),"INVALID");bytes32 leaf=keccak256(bytes.concat(keccak256(abi.encode(e,i,account,amount))));require(MerkleProof.verify(proof,x.root,leaf),"PROOF");claimed[e][i>>8]|=1<<(i&255);x.token.safeTransfer(account,amount);emit Claimed(e,i,account,amount);} }
