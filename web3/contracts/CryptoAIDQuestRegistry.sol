pragma solidity ^0.8.24;
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
contract CryptoAIDQuestRegistry is AccessControl { bytes32 public constant EDITOR_ROLE=keccak256("EDITOR_ROLE"); struct Quest{bytes32 contentHash;uint64 starts;uint64 ends;uint32 maxCompletions;uint32 completed;bool active;} mapping(bytes32=>Quest) public quests; mapping(bytes32=>mapping(address=>bool)) public completedBy; event QuestSet(bytes32 indexed id,bytes32 contentHash,uint64 starts,uint64 ends,uint32 maxCompletions,bool active); event Completed(bytes32 indexed id,address indexed user,bytes32 proof); constructor(address admin){require(admin!=address(0),"ZERO");_grantRole(DEFAULT_ADMIN_ROLE,admin);_grantRole(EDITOR_ROLE,admin);} function setQuest(bytes32 id,bytes32 hash,uint64 starts,uint64 ends,uint32 maxC,bool active) external onlyRole(EDITOR_ROLE){require(id!=bytes32(0)&&hash!=bytes32(0),"BAD");require(ends==0||ends>starts,"TIME");Quest storage q=quests[id];q.contentHash=hash;q.starts=starts;q.ends=ends;q.maxCompletions=maxC;q.active=active;emit QuestSet(id,hash,starts,ends,maxC,active);} function recordCompletion(bytes32 id,address user,bytes32 proof) external onlyRole(EDITOR_ROLE){Quest storage q=quests[id];require(q.active&&user!=address(0)&&!completedBy[id][user],"INVALID");require(block.timestamp>=q.starts&&(q.ends==0||block.timestamp<=q.ends),"WINDOW");require(q.maxCompletions==0||q.completed<q.maxCompletions,"FULL");completedBy[id][user]=true;q.completed++;emit Completed(id,user,proof);} }
