  "economy": {
    "activation_once_pol": 50,
    "activation_effect": "FIRST_CASE_CREDIT_50_AVAILABLE",
    "first_case_remainder_pol": 450,
    "subsequent_case_pol": 500,
    "credit_lifecycle": ["AVAILABLE", "RESERVED", "CONSUMED"],
    "ambiguous_payment": "MANUAL_REVIEW"
  },
  "write_policy": "CONSUMERS_NEVER_WRITE_CORE_TRUTH_DIRECTLY"
